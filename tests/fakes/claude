#!/usr/bin/env python3
"""Test double for `claude`. Writes artifacts; never talks to Anthropic."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _log(line: str) -> None:
    path = os.environ.get("FAKE_CLAUDE_LOG")
    if not path:
        return
    log = Path(path)
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")


def _node_from_prompt(prompt: str) -> str:
    if "node_id: scout" in prompt or "You are the scout node" in prompt:
        return "scout"
    if "node_id: builder" in prompt or "You are the builder node" in prompt:
        return "builder"
    return "unknown"


def main() -> int:
    _log("argv=" + " ".join(sys.argv))
    _log("cwd=" + os.getcwd())
    _log("ANTHROPIC_API_KEY=" + repr(os.environ.get("ANTHROPIC_API_KEY")))

    if len(sys.argv) >= 3 and sys.argv[1] == "auth" and sys.argv[2] == "status":
        return int(os.environ.get("FAKE_CLAUDE_AUTH_RC", "0"))

    prompt = sys.argv[-1] if sys.argv else ""
    node = _node_from_prompt(prompt)
    _log(f"node={node}")

    skip = os.environ.get(f"FAKE_CLAUDE_{node.upper()}_SKIP_WRITE")
    default_write = {"scout": "handoff.md", "builder": "DONE.md"}.get(node, "")
    write = os.environ.get(f"FAKE_CLAUDE_{node.upper()}_WRITE", default_write)
    if write and not skip:
        text = os.environ.get(
            f"FAKE_CLAUDE_{node.upper()}_TEXT",
            f"{node} artifact\n",
        )
        Path(write).write_text(text, encoding="utf-8")

    return int(os.environ.get(f"FAKE_CLAUDE_{node.upper()}_RC", "0"))


if __name__ == "__main__":
    raise SystemExit(main())
