#!/usr/bin/env python3
"""Exit 0 iff FILE contains each SECTION string. Zero LLM. Used by artifact verify."""

from __future__ import annotations

import sys
from pathlib import Path


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: has-sections FILE SECTION [SECTION...]", file=sys.stderr)
        return 2
    path = Path(argv[0])
    if not path.is_file():
        print(f"has-sections: missing {path}", file=sys.stderr)
        return 1
    text = path.read_text(encoding="utf-8", errors="replace")
    missing = [section for section in argv[1:] if section not in text]
    if missing:
        print("has-sections: missing " + ", ".join(missing), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
